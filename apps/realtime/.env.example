# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pagespace

# Port
PORT=3001

# CORS — the web app's public URL(s)
CORS_ORIGIN=http://localhost:3000
# ADDITIONAL_ALLOWED_ORIGINS=https://example.com,https://another.example.com
# Imago in local dev (apps/imago) connects from its own origin, so add it:
# ADDITIONAL_ALLOWED_ORIGINS=http://localhost:3006

# Browser clients — set in apps/web and apps/imago, not read here. Both point
# NEXT_PUBLIC_REALTIME_URL at this server; imago's dev origin is
# http://localhost:3006 and its `next dev` proxies /api/* to apps/web at
# WEB_APP_INTERNAL_URL.
# NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# WEB_APP_INTERNAL_URL=http://localhost:3000

# Sentry Error Monitoring — server-only (realtime has no client bundle).
# In production (cloud/tenant), SENTRY_DSN is required — requireSentryDsn()
# fails loud at boot without it. Onprem deployments are exempt.
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=

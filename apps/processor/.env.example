# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pagespace

# Port
PORT=3003

# ClickHouse analytics tier (#890 Phase 3) — OFF by default; only the exact
# value 'true' enables. Server-side secrets: placeholders only, never real values.
# CLICKHOUSE_ENABLED=true
# CLICKHOUSE_HOST=your-cluster.clickhouse.cloud
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your_clickhouse_password_here
# CLICKHOUSE_DATABASE=pagespace_analytics

# Sentry Error Monitoring — server-only (processor has no client bundle).
# In production (cloud/tenant), SENTRY_DSN is required — requireSentryDsn()
# fails loud at boot without it. Onprem deployments are exempt.
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=

# Content safety: avatar uploads (PR 5). The processor checks the bytes are a real
# JPEG/PNG/GIF/WebP and, unless scanning is off, asks the web app to run the
# content-safety gate before it replaces the old avatar. Use the web app's
# CONTENT_SCAN_MODE. Unreachable web app: enforce refuses, shadow accepts.
# CONTENT_SCAN_MODE=off
# SERVICE_API_SECRET=
# WEB_APP_INTERNAL_URL=http://web:3000

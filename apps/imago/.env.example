# Imago (apps/imago) — local development
#
# Imago's dev origin is http://localhost:3006 (`bun run dev`), served under
# basePath /imago: http://localhost:3006/imago. In production the edge serves
# /imago from this app and /api from apps/web on one origin.

# apps/web as this server reaches it. `next dev` rewrites /api/* (outside
# basePath) here so browser calls stay same-origin for the session cookie and
# CSRF token. Dev only: production builds carry no /api rewrite.
# Defaults to http://localhost:3000 when unset.
WEB_APP_INTERNAL_URL=http://localhost:3000

# apps/web as the browser reaches it. Read only under `next dev`, which serves
# /api but not classic's sign-in page: signed-out redirects go to this origin's
# /auth/signin (localhost cookies ignore the port, so the session reaches
# imago). Production always signs in on imago's own origin.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000

# apps/web's public URL: the origin imago's server code builds absolute
# redirects on (classic's sign-in for a rejected session, classic's
# /dashboard). Required outside next dev, where it is imago's own origin too
# (one origin serves both apps); never derived from the request's Host header.
WEB_APP_URL=http://localhost:3000

# The realtime (Socket.IO) server the browser connects to.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# apps/web and apps/realtime must also accept imago's origin; set in their envs:
# ADDITIONAL_ALLOWED_ORIGINS=http://localhost:3006

# Classic's shared cookie domain, the same value apps/web is built with: the
# theme switcher writes classic's `theme` cookie on it so both apps read one
# preference. Inlined at build time. Leave unset for host-only cookies (dev).
# Dev caveat: imago (:3006) and classic (:3000) are separate origins, so the
# switcher's localStorage `theme` mirror (read first by classic's next-themes)
# cannot reach classic; a classic tab may restore its own stored theme and
# write it back to the shared cookie. Production is one origin, where both
# apps agree. Not a bug.
# NEXT_PUBLIC_COOKIE_DOMAIN=

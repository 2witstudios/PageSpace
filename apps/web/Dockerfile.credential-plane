# The credential plane (agent accounts, ADR 0005 §10a): the only process that
# holds the Infisical provisioner credential, the plane metadata DB and the
# write-digest key. Internal-only: no public route ever points at it.
#
# Runs packages/lib's TypeScript source with bun (plane-main.ts is never built
# into or exported from the lib dist, ADR 0005 F13). @pagespace/db resolves
# through its dist exports, so db is built here. The same image runs the plane
# metadata migration one-shot:
#   bun run --filter @pagespace/lib credential-plane:migrate

FROM node:22.17.0-alpine AS deps
WORKDIR /app

COPY --from=oven/bun:1.3.12-alpine /usr/local/bin/bun /usr/local/bin/bun

# Every workspace manifest, or the frozen install fails (dockerfile-workspace-manifests.test.ts)
COPY package.json bun.lock ./
COPY packages/db/package.json ./packages/db/
COPY packages/lib/package.json ./packages/lib/
COPY packages/editor/package.json ./packages/editor/
COPY packages/browser-worker/package.json ./packages/browser-worker/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/cli/package.json ./packages/cli/
COPY apps/admin/package.json ./apps/admin/
COPY apps/android/package.json ./apps/android/
COPY apps/atlas/package.json ./apps/atlas/
COPY apps/control-plane/package.json ./apps/control-plane/
COPY apps/desktop/package.json ./apps/desktop/
COPY apps/e2e/package.json ./apps/e2e/
COPY apps/imago/package.json ./apps/imago/
COPY apps/ios/package.json ./apps/ios/
COPY apps/marketing/package.json ./apps/marketing/
COPY apps/processor/package.json ./apps/processor/
COPY apps/realtime/package.json ./apps/realtime/
COPY apps/web/package.json ./apps/web/

RUN --mount=type=cache,id=bun,target=/root/.bun/install/cache bun install --frozen-lockfile

# Only the packages: the plane imports nothing from apps/.
COPY packages ./packages
COPY tsconfig.json ./

RUN bun run --filter '@pagespace/db' build

# Production dependencies of lib and db only: the full workspace install carries
# tfjs, Next and friends, none of which the plane loads (smaller image, less
# third-party code in the process that holds plaintext).
FROM deps AS prod-deps
RUN rm -rf node_modules packages/*/node_modules apps/*/node_modules \
 && bun install --frozen-lockfile --production --filter '@pagespace/lib' --filter '@pagespace/db'

FROM node:22.17.0-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=oven/bun:1.3.12-alpine /usr/local/bin/bun /usr/local/bin/bun

RUN addgroup --system --gid 1001 plane && adduser --system --uid 1001 --ingroup plane plane

COPY --from=deps --chown=plane:plane /app/package.json /app/bun.lock /app/tsconfig.json ./
COPY --from=prod-deps --chown=plane:plane /app/node_modules ./node_modules
COPY --from=prod-deps --chown=plane:plane /app/packages ./packages

USER plane
EXPOSE 3011

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${AGENT_ACCOUNTS_PLANE_PORT:-3011}/health" >/dev/null || exit 1

# Core dumps off (ADR 0005 §7: plaintext passes through this process's memory).
CMD ["sh", "-c", "ulimit -c 0 && exec bun packages/lib/src/agent-accounts/executor/plane-main.ts"]

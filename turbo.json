{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
    },
    "db:generate": {
      "cache": false,
      "inputs": ["src/schema/**", "drizzle.config.ts"]
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "src/**/*.test.{ts,tsx}"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "package": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["dist-electron/**"]
    },
    "capture": {
      "cache": false,
      "outputs": ["output/**"]
    }
  },
  "globalDependencies": [
    ".env*",
    "docker-compose.yml",
    "drizzle.config.ts"
  ],
  "globalEnv": [
    "DATABASE_URL",
    // The scratch Admin PG. Turbo STRIPS anything not listed here, so setting
    // it on the workflow step is not enough — every `turbo run test:coverage`
    // task saw it as unset, and the suites gating on it (the GDPR eraser's
    // pseudonymization path, the audit hash-chainer, SIEM delivery) reported
    // SKIPPED while the job went green. `require-db.ts` turning that skip into
    // a loud failure is what finally surfaced it. It belongs in the cache key
    // too: a test task's result genuinely depends on whether it is set.
    "ADMIN_DATABASE_URL",
    "CSRF_SECRET",
    "ENCRYPTION_KEY",
    "WEB_APP_URL",
    "INTERNAL_REALTIME_URL",
    "PORT",
    "CORS_ORIGIN",
    "OLLAMA_BASE_URL",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "GOOGLE_AI_API_KEY",
    "OPENROUTER_DEFAULT_API_KEY",
    "PAGESPACE_URL",
    "NEXT_PUBLIC_*"
  ]
}